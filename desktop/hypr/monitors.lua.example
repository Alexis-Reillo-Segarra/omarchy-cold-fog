-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

-- Straight 1x setup: two 1080p monitors, not retina-class. Omarchy's default is
-- 2, which renders GTK apps at double size on displays this size.
local omarchy_gdk_scale = 1

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))

-- Catch-all first, so a monitor plugged in later still comes up.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

-- DP-1 (AOC 24G2W1G3, physically on the left)  -> 165Hz max
-- DP-2 (AOC 25G3ZM, physically on the right)   -> 240Hz max
-- Both need an explicit mode: "preferred" picks 60Hz on these panels.
hl.monitor({ output = "DP-1", mode = "1920x1080@165", position = "0x0", scale = 1 })
hl.monitor({ output = "DP-2", mode = "1920x1080@239.96", position = "1920x0", scale = 1 })
